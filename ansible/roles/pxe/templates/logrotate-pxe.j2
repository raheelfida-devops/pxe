# Managed by Ansible.
{{ pxe_log_file }} {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 syslog adm
    sharedscripts
    postrotate
        if /usr/bin/systemctl is-active --quiet rsyslog.service; then
            /usr/bin/systemctl kill --kill-who=main --signal=HUP rsyslog.service
        fi
    endscript
}
